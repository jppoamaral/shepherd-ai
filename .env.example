# Copy to .env (repo root for docker compose; backend/ for local runs).
# Local runs talk to the compose Postgres on localhost.
DATABASE_URL=postgresql+psycopg://shepherd:shepherd@localhost:5432/shepherd

# Browser origins allowed to call the API (JSON list).
CORS_ORIGINS=["http://localhost:4300","http://127.0.0.1:4300","http://localhost:4200","http://127.0.0.1:4200"]

# Weeks ahead the worker keeps gatherings generated.
GATHERING_HORIZON_WEEKS=12

# How approved messages leave Shepherd: copy_paste, or simulator (the demo volunteer chat).
# The seeds put Grace Community on simulator; override per church by name if needed.
DEFAULT_CHANNEL=copy_paste
# CHANNEL_BY_CHURCH={"Grace Community":"simulator"}

# Run the nightly job inside the API process (hosts without background workers, e.g. free
# Render). docker compose runs the separate worker instead, so leave it off locally.
RUN_SCHEDULER=false
# Enables POST /demo/reset, which empties the database and reloads the seeds. Synthetic data only.
DEMO_MODE=false

# Azure OpenAI (unused until a later milestone; tests use FakeLLM).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=

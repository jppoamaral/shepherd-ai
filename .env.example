# Copy to .env (repo root for docker compose; backend/ for local runs).
# Local runs talk to the compose Postgres on localhost.
DATABASE_URL=postgresql+psycopg://shepherd:shepherd@localhost:5432/shepherd

# Browser origins allowed to call the API (JSON list).
CORS_ORIGINS=["http://localhost:4200","http://127.0.0.1:4200"]

# Weeks ahead the worker keeps gatherings generated.
GATHERING_HORIZON_WEEKS=12

# Azure OpenAI (unused until a later milestone; tests use FakeLLM).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=
